<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text styles (Phase 14). parent="" on purpose: no style named "Text" exists, so no parent is inferred from the dotted name. -->
    <style name="Text.Title" parent="">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Text.RowTitle" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Text.Meta" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_dim</item>
    </style>

    <style name="Text.Brand" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>
</resources>
