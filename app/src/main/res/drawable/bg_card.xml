<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_focus" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_focus" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <!-- Android angle 315 = top-left to bottom-right (the CSS "135deg" look) -->
            <gradient
                android:angle="315"
                android:endColor="#0F141C"
                android:startColor="#171E2A"
                android:type="linear" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
</selector>
