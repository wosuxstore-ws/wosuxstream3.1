<?xml version="1.0" encoding="utf-8"?>
<!-- Hero banner (Phase 22), first item of Home. Left: LIVE chip, channel name, category, Watch + My List buttons.
     Right: logo (or initials) on a soft plate. Root = bg_hero, so there is only one background drawn. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/hero_h"
    android:layout_margin="@dimen/screen_pad"
    android:background="@drawable/bg_hero"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_live"
            android:letterSpacing="0.1"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="@string/hero_live"
            android:textColor="@color/text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/heroName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/heroCategory"
            style="@style/Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnWatch"
                style="@style/Btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_primary"
                android:minHeight="36dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/hero_watch"
                android:textColor="@color/bg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnHeroList"
                style="@style/Btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:minHeight="36dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/hero_list"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="@dimen/hero_plate_w"
        android:layout_height="@dimen/hero_plate_h"
        android:layout_marginStart="12dp">

        <!-- The plate is the ImageView's own background (bg_logo), as on the channel cards -->
        <ImageView
            android:id="@+id/heroLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_logo"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/heroMono"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="40sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
